# Groq API Configuration (Mandatory Stack Model: gemma2-9b-it or llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=gemma2-9b-it

# Database Configuration (Defaults to SQLite; supports PostgreSQL or MySQL)
# Example PostgreSQL: postgresql://user:password@localhost:5432/qms_complaints
# Example MySQL: mysql+pymysql://user:password@localhost:3306/qms_complaints
DATABASE_URL=sqlite:///./complaints_qms.db
